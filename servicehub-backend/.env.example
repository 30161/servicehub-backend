PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/servicehub?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Maps JavaScript API key. Enable Maps JavaScript API in Google Cloud.
# This browser key is public; restrict it to your local/deployed website origins in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Google PageSpeed Insights API key. Optional. Keep this server-side secret private.
PAGESPEED_API_KEY=

# Twilio credentials for real number-masked calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
