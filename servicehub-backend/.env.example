PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/servicehub?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Google Maps JavaScript API key. Enable Maps JavaScript API in Google Cloud.
# This browser key is public; restrict it to your local/deployed website origins in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Google PageSpeed Insights API key. Optional. Keep this server-side secret private.
PAGESPEED_API_KEY=

# Optional Google Search Console HTML verification code. Set only the meta content value.
GOOGLE_SITE_VERIFICATION=

# Optional GA4 measurement ID (for example G-XXXXXXXXXX).
GOOGLE_ANALYTICS_ID=

# Firebase web app settings for Google sign-in. These values are public.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase Admin SDK: use a service-account JSON value, or configure
# GOOGLE_APPLICATION_CREDENTIALS with the path to the service-account file.
FIREBASE_SERVICE_ACCOUNT_JSON=

# SMTP settings for the email OTP sent after Google sign-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ProConnect

# Twilio credentials for real number-masked calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
