PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/servicehub
JWT_SECRET=replace-with-a-long-random-secret

# Google Maps JavaScript API key. Enable Maps JavaScript API in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Google PageSpeed Insights API key. Optional, but recommended for API quotas.
PAGESPEED_API_KEY=

# Twilio credentials for real number-masked calls.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
